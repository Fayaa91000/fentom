BEGIN;

-- 1. FREELANCER PAYMENT SETTINGS

CREATE TABLE IF NOT EXISTS
public.meg_skills_freelancer_payments (
  freelancer_id uuid PRIMARY KEY
    REFERENCES public.meg_skills_freelancers(id),

  bank_transfer_enabled boolean NOT NULL DEFAULT false,
  bank_name text,
  bank_account_name text,
  bank_account_number text,

  online_payment_enabled boolean NOT NULL DEFAULT false,
  gateway_name text,
  gateway_url text,

  updated_at timestamptz NOT NULL DEFAULT now(),

  CONSTRAINT meg_skills_bank_details_check CHECK (
    NOT bank_transfer_enabled OR (
      length(btrim(coalesce(bank_name,''))) BETWEEN 2 AND 120
      AND length(btrim(coalesce(bank_account_name,''))) BETWEEN 2 AND 160
      AND length(btrim(coalesce(bank_account_number,''))) BETWEEN 4 AND 100
    )
  ),

  CONSTRAINT meg_skills_online_details_check CHECK (
    NOT online_payment_enabled OR (
      length(btrim(coalesce(gateway_name,''))) BETWEEN 2 AND 120
      AND length(coalesce(gateway_url,'')) <= 1000
      AND gateway_url ~* '^https://[^[:space:]]+$'
    )
  )
);

ALTER TABLE public.meg_skills_freelancer_payments
ENABLE ROW LEVEL SECURITY;

REVOKE ALL ON public.meg_skills_freelancer_payments
FROM PUBLIC, anon, authenticated;


-- Save freelancer payment settings.

CREATE OR REPLACE FUNCTION
public.meg_skills_save_freelancer_payment(
  p_bank_enabled boolean,
  p_bank_name text,
  p_account_name text,
  p_account_number text,
  p_online_enabled boolean,
  p_gateway_name text,
  p_gateway_url text
)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $$
DECLARE
  v_freelancer uuid;
BEGIN
  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'Sign in required';
  END IF;

  SELECT id INTO v_freelancer
  FROM public.meg_skills_freelancers
  WHERE user_id = auth.uid()
    AND status = 'approved';

  IF v_freelancer IS NULL THEN
    RAISE EXCEPTION 'Approved freelancer account required';
  END IF;

  IF p_bank_enabled IS NULL OR p_online_enabled IS NULL THEN
    RAISE EXCEPTION 'Choose enabled payment methods';
  END IF;

  IF p_bank_enabled AND (
    length(btrim(coalesce(p_bank_name,''))) NOT BETWEEN 2 AND 120
    OR length(btrim(coalesce(p_account_name,''))) NOT BETWEEN 2 AND 160
    OR length(btrim(coalesce(p_account_number,''))) NOT BETWEEN 4 AND 100
  ) THEN
    RAISE EXCEPTION 'Valid bank details required';
  END IF;

  IF p_online_enabled AND (
    length(btrim(coalesce(p_gateway_name,''))) NOT BETWEEN 2 AND 120
    OR length(coalesce(p_gateway_url,'')) > 1000
    OR coalesce(p_gateway_url,'') !~* '^https://[^[:space:]]+$'
  ) THEN
    RAISE EXCEPTION 'Valid HTTPS gateway URL required';
  END IF;

  INSERT INTO public.meg_skills_freelancer_payments (
    freelancer_id,
    bank_transfer_enabled,
    bank_name,
    bank_account_name,
    bank_account_number,
    online_payment_enabled,
    gateway_name,
    gateway_url,
    updated_at
  )
  VALUES (
    v_freelancer,
    p_bank_enabled,
    nullif(btrim(p_bank_name),''),
    nullif(btrim(p_account_name),''),
    nullif(btrim(p_account_number),''),
    p_online_enabled,
    nullif(btrim(p_gateway_name),''),
    nullif(btrim(p_gateway_url),''),
    now()
  )
  ON CONFLICT (freelancer_id) DO UPDATE SET
    bank_transfer_enabled = EXCLUDED.bank_transfer_enabled,
    bank_name = EXCLUDED.bank_name,
    bank_account_name = EXCLUDED.bank_account_name,
    bank_account_number = EXCLUDED.bank_account_number,
    online_payment_enabled = EXCLUDED.online_payment_enabled,
    gateway_name = EXCLUDED.gateway_name,
    gateway_url = EXCLUDED.gateway_url,
    updated_at = now();
END;
$$;

REVOKE ALL ON FUNCTION
public.meg_skills_save_freelancer_payment(
  boolean,text,text,text,boolean,text,text
)
FROM PUBLIC, anon;

GRANT EXECUTE ON FUNCTION
public.meg_skills_save_freelancer_payment(
  boolean,text,text,text,boolean,text,text
)
TO authenticated;


-- Read own freelancer payment settings.

CREATE OR REPLACE FUNCTION
public.meg_skills_get_freelancer_payment()
RETURNS SETOF public.meg_skills_freelancer_payments
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = ''
AS $$
BEGIN
  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'Sign in required';
  END IF;

  RETURN QUERY
  SELECT p.*
  FROM public.meg_skills_freelancer_payments p
  JOIN public.meg_skills_freelancers f
    ON f.id = p.freelancer_id
  WHERE f.user_id = auth.uid();
END;
$$;

REVOKE ALL ON FUNCTION
public.meg_skills_get_freelancer_payment()
FROM PUBLIC, anon;

GRANT EXECUTE ON FUNCTION
public.meg_skills_get_freelancer_payment()
TO authenticated;


-- 2. CUSTOMER PAYMENT RECORDS
-- Snapshot freelancer bank/gateway information
-- when an order is accepted.

CREATE TABLE IF NOT EXISTS
public.meg_skills_customer_payments (
  order_id uuid PRIMARY KEY
    REFERENCES public.meg_skills_orders(id),

  customer_id uuid NOT NULL
    REFERENCES auth.users(id),

  freelancer_user_id uuid NOT NULL
    REFERENCES auth.users(id),

  amount_mvr numeric(12,2) NOT NULL
    CHECK (amount_mvr > 0),

  bank_transfer_enabled boolean NOT NULL,
  bank_name text,
  bank_account_name text,
  bank_account_number text,

  online_payment_enabled boolean NOT NULL,
  gateway_name text,
  gateway_url text,

  status text NOT NULL DEFAULT 'unpaid'
    CHECK (
      status IN (
        'unpaid',
        'under_review',
        'verified'
      )
    ),

  verified_at timestamptz,
  verified_by uuid REFERENCES auth.users(id),

  test_only boolean NOT NULL DEFAULT true
    CHECK (test_only = true),

  created_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE public.meg_skills_customer_payments
ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS
meg_skills_customer_payment_read
ON public.meg_skills_customer_payments;

CREATE POLICY meg_skills_customer_payment_read
ON public.meg_skills_customer_payments
FOR SELECT TO authenticated
USING (
  customer_id = (SELECT auth.uid())
  OR freelancer_user_id = (SELECT auth.uid())
  OR (SELECT public.meg_skills_is_admin())
);

REVOKE ALL ON public.meg_skills_customer_payments
FROM PUBLIC, anon, authenticated;

GRANT SELECT ON public.meg_skills_customer_payments
TO authenticated;


-- Automatically snapshot instructions when accepted.

CREATE OR REPLACE FUNCTION
public.meg_skills_capture_payment_instructions()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $$
DECLARE
  v_settings public.meg_skills_freelancer_payments%ROWTYPE;
  v_owner uuid;
BEGIN

  IF NEW.status <> 'accepted'
     OR OLD.status = 'accepted' THEN
    RETURN NEW;
  END IF;

  SELECT f.user_id INTO v_owner
  FROM public.meg_skills_freelancers f
  WHERE f.id = NEW.freelancer_id;

  SELECT * INTO v_settings
  FROM public.meg_skills_freelancer_payments
  WHERE freelancer_id = NEW.freelancer_id;

  IF NOT FOUND OR (
    NOT v_settings.bank_transfer_enabled
    AND NOT v_settings.online_payment_enabled
  ) THEN
    RAISE EXCEPTION
      'Freelancer must configure a payment method before accepting new orders';
  END IF;

  INSERT INTO public.meg_skills_customer_payments (
    order_id,
    customer_id,
    freelancer_user_id,
    amount_mvr,
    bank_transfer_enabled,
    bank_name,
    bank_account_name,
    bank_account_number,
    online_payment_enabled,
    gateway_name,
    gateway_url
  )
  VALUES (
    NEW.id,
    NEW.customer_id,
    v_owner,
    NEW.agreed_price_mvr,
    v_settings.bank_transfer_enabled,
    v_settings.bank_name,
    v_settings.bank_account_name,
    v_settings.bank_account_number,
    v_settings.online_payment_enabled,
    v_settings.gateway_name,
    v_settings.gateway_url
  )
  ON CONFLICT (order_id) DO NOTHING;

  RETURN NEW;
END;
$$;

REVOKE ALL ON FUNCTION
public.meg_skills_capture_payment_instructions()
FROM PUBLIC, anon, authenticated;

DROP TRIGGER IF EXISTS
meg_skills_capture_payment_on_acceptance
ON public.meg_skills_orders;

CREATE TRIGGER meg_skills_capture_payment_on_acceptance
AFTER UPDATE OF status
ON public.meg_skills_orders
FOR EACH ROW
WHEN (
  NEW.status = 'accepted'
  AND OLD.status IS DISTINCT FROM NEW.status
)
EXECUTE FUNCTION
public.meg_skills_capture_payment_instructions();


