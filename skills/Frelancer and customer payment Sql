-- 6. CUSTOMER SUBMITS PAYMENT RECEIPT

CREATE OR REPLACE FUNCTION
public.meg_skills_submit_customer_receipt(
  p_order_id uuid,
  p_method text,
  p_reference text,
  p_storage_path text
)
RETURNS uuid
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $$
DECLARE
  v_payment public.meg_skills_customer_payments%ROWTYPE;
  v_receipt uuid;
BEGIN

  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'Sign in required';
  END IF;

  SELECT * INTO v_payment
  FROM public.meg_skills_customer_payments
  WHERE order_id = p_order_id
  FOR UPDATE;

  IF NOT FOUND
     OR v_payment.customer_id <> auth.uid()
     OR v_payment.status <> 'unpaid' THEN
    RAISE EXCEPTION 'Receipt submission denied';
  END IF;

  IF NOT (
    (p_method = 'bank_transfer'
      AND v_payment.bank_transfer_enabled)
    OR
    (p_method = 'online'
      AND v_payment.online_payment_enabled)
  ) THEN
    RAISE EXCEPTION 'Payment method unavailable';
  END IF;

  IF length(coalesce(p_reference,'')) > 150 THEN
    RAISE EXCEPTION 'Payment reference too long';
  END IF;

  IF p_storage_path IS NULL
     OR split_part(p_storage_path,'/',1)
       <> p_order_id::text
     OR split_part(p_storage_path,'/',2)
       <> auth.uid()::text
     OR split_part(p_storage_path,'/',3) = ''
     OR p_storage_path ~ '\.\.'
  THEN
    RAISE EXCEPTION 'Invalid receipt path';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM storage.objects obj
    WHERE obj.bucket_id =
      'meg-skills-customer-receipts'
      AND obj.name = p_storage_path
  ) THEN
    RAISE EXCEPTION 'Uploaded receipt not found';
  END IF;

  INSERT INTO public.meg_skills_customer_receipts (
    order_id,
    uploaded_by,
    payment_method,
    payment_reference,
    storage_path
  )
  VALUES (
    p_order_id,
    auth.uid(),
    p_method,
    nullif(btrim(p_reference),''),
    p_storage_path
  )
  RETURNING id INTO v_receipt;

  UPDATE public.meg_skills_customer_payments
  SET status = 'under_review'
  WHERE order_id = p_order_id;

  INSERT INTO
  public.meg_skills_customer_payment_events (
    order_id,
    receipt_id,
    actor_id,
    event_type
  )
  VALUES (
    p_order_id,
    v_receipt,
    auth.uid(),
    'receipt_submitted'
  );

  RETURN v_receipt;
END;
$$;


-- 7. FREELANCER REVIEWS CUSTOMER RECEIPT

CREATE OR REPLACE FUNCTION
public.meg_skills_review_customer_receipt(
  p_receipt_id uuid,
  p_decision text,
  p_note text,
  p_receipt_checked boolean DEFAULT false
)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $$
DECLARE
  v_receipt public.meg_skills_customer_receipts%ROWTYPE;
  v_payment public.meg_skills_customer_payments%ROWTYPE;
BEGIN

  IF auth.uid() IS NULL THEN
    RAISE EXCEPTION 'Sign in required';
  END IF;

  IF p_decision NOT IN ('approved','rejected') THEN
    RAISE EXCEPTION 'Invalid review decision';
  END IF;

  IF length(btrim(coalesce(p_note,'')))
     NOT BETWEEN 5 AND 2000 THEN
    RAISE EXCEPTION
      'Review note must be 5–2000 characters';
  END IF;

  IF p_decision = 'approved'
     AND p_receipt_checked IS DISTINCT FROM true THEN
    RAISE EXCEPTION
      'Confirm actual payment receipt verification';
  END IF;

  SELECT * INTO v_receipt
  FROM public.meg_skills_customer_receipts
  WHERE id = p_receipt_id
  FOR UPDATE;

  IF NOT FOUND
     OR v_receipt.status <> 'pending' THEN
    RAISE EXCEPTION 'No pending receipt found';
  END IF;

  SELECT * INTO v_payment
  FROM public.meg_skills_customer_payments
  WHERE order_id = v_receipt.order_id
  FOR UPDATE;

  IF NOT FOUND
     OR v_payment.freelancer_user_id <> auth.uid()
     OR v_payment.status <> 'under_review' THEN
    RAISE EXCEPTION
      'Only the assigned freelancer can verify this receipt';
  END IF;

  UPDATE public.meg_skills_customer_receipts
  SET status = p_decision,
      review_note = btrim(p_note),
      reviewed_by = auth.uid(),
      reviewed_at = now()
  WHERE id = p_receipt_id;

  UPDATE public.meg_skills_customer_payments
  SET status = CASE
      WHEN p_decision = 'approved'
      THEN 'verified'
      ELSE 'unpaid'
    END,
    verified_at = CASE
      WHEN p_decision = 'approved'
      THEN now()
      ELSE NULL
    END,
    verified_by = CASE
      WHEN p_decision = 'approved'
      THEN auth.uid()
      ELSE NULL
    END
  WHERE order_id = v_receipt.order_id;

  INSERT INTO
  public.meg_skills_customer_payment_events (
    order_id,
    receipt_id,
    actor_id,
    event_type
  )
  VALUES (
    v_receipt.order_id,
    p_receipt_id,
    auth.uid(),
    CASE
      WHEN p_decision = 'approved'
      THEN 'receipt_approved'
      ELSE 'receipt_rejected'
    END
  );
END;
$$;

